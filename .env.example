# Every Olano setting can be written as OLANO_<NAME> or as the older LIONCLAW_<NAME>;
# both spellings work everywhere. When both are set with different values the
# legacy LIONCLAW_<NAME> wins (one exception: OLANO_HOME outranks LIONCLAW_HOME).

# ── LLM Provider API Keys ──────────────────────────────────────────────────────
# Every provider package ships in the base install; set the key for the ones you use.
ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_gemini_key_here
# FIREWORKS_API_KEY=your_fireworks_key_here
# GROQ_API_KEY=your_groq_key_here
# XAI_API_KEY=your_xai_grok_key_here
# DEEPSEEK_API_KEY=your_deepseek_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here          # provider: openrouter:<model>
# DASHSCOPE_API_KEY=your_alibaba_dashscope_key_here    # provider: qwq:<qwq*|qwen*>; also Qwen-TTS (speech.tts.provider=qwen)
# MOONSHOT_API_KEY=your_moonshot_kimi_key_here         # provider: moonshot:<kimi*>
# HUGGINGFACEHUB_API_TOKEN=your_hf_token_here          # provider: huggingface:<repo_id>

# ── LangSmith (optional — tracing/debugging) ──────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=olano

# ── Workspace ─────────────────────────────────────────────────────────────────
# OLANO_HOME — where Olano keeps agents, vault, sessions, logs and config.
# Set this on NEW deployments. Resolution order when it is unset:
#   $OLANO_HOME → $LIONCLAW_HOME → ~/.olano (if present) → ~/olano (if present
#   and not a source checkout: an install made while that visible name was the
#   default) → ~/.lionclaw (if present) → ~/.olano (created). A checkout of
#   this repository at ~/olano is never the home, so the data never lands
#   inside a git work tree.
# Existing instances need no change: a box already running out of ~/olano or
# ~/.lionclaw keeps using it, and LIONCLAW_HOME is still honoured. Nothing is
# migrated for you — moving an existing home is a deliberate, manual operation.
# OLANO_HOME=/root/.olano
# LIONCLAW_WORKSPACE=/path/to/custom/workspace

# ── Gateway / Dashboard ───────────────────────────────────────────────────────
# LIONCLAW_GATEWAY_PORT=8765          # Python REST API port (default: 8765)
# LIONCLAW_DASHBOARD_PORT=3200        # Node.js dashboard port (default: 3200)
# LIONCLAW_DASHBOARD_TOKEN=secret     # Optional Bearer token to protect the API
# LIONCLAW_NO_DISK_MONITOR=1          # Kill the disk monitor + auto-cleanup loop for this boot
#                                     # (normally tune it in config.yaml -> disk_monitor: instead)

# ── Persistence backend (thread checkpoints + Store) ─────────────────────────
# Default is local SQLite (zero-config, embedded — fine for a single node).
# For scale (dozens of agents/subagents/cognition/channels), use Postgres for
# true concurrent writes. The Docker/deploy stack provisions a Postgres sidecar
# and DEFAULTS to it — leave these unset there. Set them to point at an external
# Postgres, or set LIONCLAW_CHECKPOINT_BACKEND=sqlite to opt out.
#   - In Docker, the host is the compose service name `postgres`, not localhost.
#   - Needs the postgres extra (already baked into the Docker image).
# LIONCLAW_CHECKPOINT_BACKEND=postgres            # 'sqlite' (default) | 'postgres'
# LIONCLAW_CHECKPOINT_DB_URL=postgresql://olano:<password>@postgres:5432/olano
# LIONCLAW_STORE_BACKEND=postgres                 # mirrors checkpoint; inherits the URL below if unset
# LIONCLAW_STORE_DB_URL=postgresql://olano:<password>@postgres:5432/olano
# LIONCLAW_CHECKPOINT_POOL_MAX=20                 # Postgres connection-pool size
# OLANO_PG_NAME=olano                              # Docker/deploy stack only: the bundled
#   Postgres sidecar's role, database and named-volume stem, all three at once (Postgres
#   applies the names only when it initialises the data dir, so they must never drift
#   from the data). The deploy scripts pin it before the first `up` (ensure_pg_name in
#   deploy/env-lib.sh; install.sh keeps its own in <home>/.env): olano on a fresh box,
#   lionclaw wherever a data dir was initialised under that name. The compose files fall
#   back to lionclaw when it is unset, so an unpinned existing box keeps its data.
# LIONCLAW_PG_PASSWORD=<password>                 # password for the bundled Docker Postgres
#   sidecar (compose default 'lionclaw'). If you change it to one with URL-special chars
#   (@ : / etc.), also set LIONCLAW_CHECKPOINT_DB_URL explicitly with it URL-encoded.
#   The deploy scripts pin a random one before the first `up` (ensure_pg_password in
#   deploy/env-lib.sh; install.sh keeps its own in <home>/.env) — leave it unset there.
# LIONCLAW_PGDATA=/home/olano/pgdata               # Docker/deploy stack only: where the bundled
#   Postgres keeps its data dir. A path = bind mount (the sealed data volume on managed
#   boxes); a bare name = the project-prefixed named volume (default <OLANO_PG_NAME>_pgdata).

# ── Vault + quick-setup (one-shot non-interactive bootstrap) ──────────────────
# `olano quick-setup --yes` seeds home + workspace + agent + admin + vault.
# Nothing here is required. With no admin password set, quick-setup generates a
# one-time password, prints it once and keeps it at <home>/run/initial-admin-password
# until you change it. With no vault key set, it generates a vault passphrase and
# stores it in the vault's boot-key file, which the runtime unlocks from on its
# own. Set these only to choose the values yourself; OLANO_VAULT_KEY must then
# match the passphrase the vault was created with. (The older spelling
# LIONCLAW_VAULT_KEY is still read.)
# OLANO_VAULT_KEY=
# LIONCLAW_ADMIN_EMAIL=admin@example.com    # quick-setup admin login
# LIONCLAW_ADMIN_PASSWORD=                   # quick-setup admin password
# LIONCLAW_VAULT_PASSWORD=                   # quick-setup vault passphrase

# ── Web Search — Tavily (required for web_search / web_extract tools) ─────────
# TAVILY_API_KEY=tvly-your_tavily_key_here

# ── Web Scraping — Firecrawl (required for firecrawl_* tools) ─────────────────
# FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# ── Vision / Image Description ────────────────────────────────────────────────
# Pins the model the image_describe tool runs on. Optional: with this unset the
# tool tries olano:vision (managed deployments, billed in olano credits) and
# then every provider key that IS configured — anthropic:claude-haiku-4-5-20251001,
# openai:gpt-5.4-mini, google_genai:gemini-2.5-flash — falling through when one
# is out of credits or unauthorized. Setting it disables that fallback: only the
# model named here is used, so a broken pin reports itself instead of quietly
# billing somewhere else. This is also how you move vision off olano credits
# onto your own provider account.
# LIONCLAW_VISION_MODEL=anthropic:claude-haiku-4-5-20251001

# ── Google Services (Gmail, Calendar, Drive) ──────────────────────────────────
# Connect from the dashboard Connections tab, or run `olano auth google`.
# Token is cached at <home>/google_token.json (~/.olano by default) after first auth.
# GOOGLE_OAUTH_CLIENT={"client_id":"...","client_secret":"..."}  # OAuth client (pasted client_secret.json also works)
# GOOGLE_OAUTH_CREDENTIALS=/path/to/client_secret.json   # legacy: path to the client secrets file

# ── Telegram Channel ──────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → get the token
# 2. Set it here or in agent.yaml under channels: [{type: telegram, token: ...}]
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef-your_bot_token_here

# ── Discord Channel ───────────────────────────────────────────────────────────
# 1. Create an app at https://discord.com/developers/applications
# 2. Add a Bot, enable MESSAGE CONTENT intent, invite to server
# DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── Slack Channel ─────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-slack-app-token  # required for Socket Mode

# ── WhatsApp Bridge (Node.js Baileys) ─────────────────────────────────────────
# WHATSAPP_BRIDGE_SCRIPT=./whatsapp-bridge/index.js

# ── DeBox Channel (Web3 chat bot) ─────────────────────────────────────────────
# 1. Open BotMother in DeBox (AI assistant entry, or deep link
#    https://m.debox.pro/user/chat?id=u7ooqdjt) and create a bot.
# 2. From the bot management page copy the API Key into DEBOX_BOT_TOKEN
#    (and the App Secret into DEBOX_API_SECRET, if one was issued).
# 3. Configure per-agent in agent.json5 under channels:
#    [{type: "platform:debox", token: "${DEBOX_BOT_TOKEN}"}]
#    The agent long-polls DeBox (like Telegram) — no public URL required.
#    IMPORTANT: leave the bot's Webhook URL unset in BotMother; DeBox's two
#    receive modes are mutually exclusive and a configured webhook disables
#    polling.
# DEBOX_BOT_TOKEN=your_debox_api_key_here
# DEBOX_API_SECRET=            # App Secret (request signing); usually empty
#
# Alternative webhook transport (set App Domain + Webhook URL in BotMother;
# needs a public HTTPS URL ending in /debox/webhook in front of the agent):
#    [{type: "platform:debox", token: "${DEBOX_BOT_TOKEN}",
#      extra: {webhook_key: "${DEBOX_WEBHOOK_KEY}", port: 8650}}]
# DEBOX_WEBHOOK_KEY=your_debox_webhook_key_here

# ── ChromaDB (RAG / knowledge base) ───────────────────────────────────────────
# Default: embedded local Chroma (no server needed).
# Uncomment only if running a remote Chroma server:
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ── MCP OAuth redirect (chat/agent-driven MCP authorization) ─────────────────
# For an agent to hand out working MCP magic links over Telegram/WhatsApp/etc,
# the deployment needs a browser-reachable HTTPS redirect. Two options (relay
# wins when both are set); with NEITHER set, chat-driven MCP OAuth fails with
# "No MCP OAuth redirect target configured".
#
# Option A — central relay (olano cloud; works for domain-less droplets and
# DCR-less providers like HubSpot). This is what a fleet of instances
# (DigitalOcean/AWS/Tencent) shares: ONE registered redirect URI
# (https://auth.olano.ai/mcp/callback) for all of them at once — the OAuth
# `state` routes each provider's callback back to the instance that started it.
# Cloud-provisioned instances get these automatically via /opt/olano/olano.env —
# do not set them by hand there. For self-serve deploys, the deploy scripts
# (deploy/*-deploy.sh + bootstrap-*.sh) auto-wire the relay when you supply
# LIONCLAW_MCP_RELAY_SECRET at deploy time; the URL defaults to
# https://auth.olano.ai. Setting the URL WITHOUT a secret makes all MCP OAuth
# fail — they must be set together.
# LIONCLAW_MCP_RELAY_URL=https://auth.olano.ai
# LIONCLAW_MCP_RELAY_SECRET=per-deployment-secret     # or store in the vault
# LIONCLAW_INSTANCE_ID=stable-deployment-id           # auto-generated if unset
#
# Option B — this deployment's own public HTTPS origin (the all-in-one deploy
# sets this automatically during bootstrap to the host it was deployed with:
# https://<name>.olano.run when OLANO_HOST/SSLIP_HOST was set, else the dev
# default https://<ip>.sslip.io).
# LIONCLAW_PUBLIC_URL=https://acme.olano.run
#
# An https:// public URL also switches the dashboard session to a Secure
# `__Host-lc_session` cookie (hardening against cookie tossing from sibling
# hosts). Force the mode only when TLS terminates somewhere the runtime can't
# infer it from LIONCLAW_PUBLIC_URL:
# LIONCLAW_SECURE_COOKIES=1

# ── Olano credits on a self-hosted install ───────────────────────────────────
# An Olano ACCOUNT API key (cloud.olano.ai → API keys, `sk-olano-…`) makes this
# box run the olano:* tiers, image generation/editing, vision, speech and web
# search on your account's credits, exactly like a managed deployment, with no
# provider accounts. The dashboard's Providers → Olano card (and the first-run
# wizard) store it in the vault for you; set it here only for an unattended
# install. Agents on the default:* tiers move to the Olano tiers at their next
# start while a key is present. It is NOT a deployment token and never makes
# the box "managed".
# OLANO_CREDITS_KEY=sk-olano-...

# ── Cloud control plane (cloud.olano.ai) ─────────────────────────────────────
# Per-deployment runtime token: authenticates the signed-settings pull AND the
# background usage reporter that feeds cloud.olano.ai → Usage (tokens/requests
# per instance). Cloud-provisioned droplets get this automatically via
# /opt/olano/olano.env (written by cloud-init; the runtime loads that file at
# every startup) together with the installation manifest the token belongs
# with. Do NOT set it by hand on a self-hosted box: a deployment token with no
# manifest reads as a broken managed install and the runtime quarantines
# itself (every execution gate closes). To run a self-hosted box on credits use
# OLANO_CREDITS_KEY above instead. Usage reporting is on whenever the token is
# present; disable with LIONCLAW_USAGE_REPORT=0.
# LIONCLAW_DEPLOYMENT_TOKEN=olano_dep_...   # managed deployments only
# LIONCLAW_CLOUD_API_URL=https://cloud.olano.ai   # default; rarely needed

# ── Cloud catalog sync (models/pricing + MCP directory) ──────────────────────
# The runtime polls the cloud's per-catalog revision manifest (default hourly,
# `catalog_sync:` block in config.yaml) and re-fetches only catalogs that
# changed; browsing always serves from disk cache → bundled snapshot. These
# are rarely needed:
# LIONCLAW_CATALOG_API_URL=https://api.olano.ai   # catalog host override
# LIONCLAW_NO_CATALOG_SYNC=1                      # disable the background sync
# LIONCLAW_MODEL_CATALOG_TTL=600                  # in-process cache TTL (s)
# LIONCLAW_MCP_DIRECTORY_TTL=600                  # in-process cache TTL (s)

# ── Agent sandbox resources ──────────────────────────────────────────────────
# Ceilings for the Docker sandbox container each agent's shell commands run in.
# Unset (the default) means automatic: the runtime sizes every sandbox from the
# detected host — 25% of RAM and 50% of the cores, never below 512m / 0.5 — so a
# bigger machine needs no configuration at all. These are ceilings, not
# reservations: an idle sandbox consumes nothing.
# Precedence, highest first: an agent's own `sandbox:` block in agent.json5 →
# these variables → the `sandbox:` block in config.yaml (dashboard Config →
# Sandbox resources) → automatic. Set them only to pin a deployment-wide value
# that must not be edited from the dashboard; a change takes effect on each
# agent's next start, which recreates its sandbox container.
# LIONCLAW_SANDBOX_MEMORY=4g   # docker size string; minimum 6m
# LIONCLAW_SANDBOX_CPUS=2      # cores (0.1–64); 0.5 = half a core
# LIONCLAW_SANDBOX_IMAGE=ghcr.io/olano-ai/olano-sandbox:latest  # pin a tag/sha
