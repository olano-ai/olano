{
  "name": "olano-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Olano mobile app: native-looking screens (Ionic + Capacitor) that talk to an Olano deployment's API.",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" && node scripts/check-versions.mjs && node scripts/check-store-readiness.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "icons": "python3 scripts/make_icons.py",
    "check:store": "node scripts/check-store-readiness.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@ionic/react": "9.0.8",
    "@ionic/react-router": "9.0.8",
    "highlight.js": "11.12.0",
    "ionicons": "8.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
