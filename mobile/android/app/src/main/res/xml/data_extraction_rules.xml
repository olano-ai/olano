<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher (android:dataExtractionRules). Only the saved
     deployment address goes to a cloud backup or a new phone; the web view's
     session cookies and storage stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="olano_shell.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="olano_shell.xml" />
    </device-transfer>
</data-extraction-rules>
