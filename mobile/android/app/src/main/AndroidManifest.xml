<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the saved deployment address is backed up or moved to a new phone
         (res/xml/backup_rules.xml, data_extraction_rules.xml). The web view's
         cookies and storage hold the session for that deployment and stay on
         this device. Cleartext is off; src/debug/AndroidManifest.xml turns it
         on for debug builds, which may point at http:// boxes on the LAN. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share into Olano from another app: a file, a photo, a link
                 or some text, handed to an agent the person picks
                 (OlanoShellPlugin.takeShared, src/native/shareIn.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Choosing photos uses the system photo picker. Phones whose Android
             predates it get Google Play's copy installed (otherwise the
             picker falls back to the file chooser). -->
        <!--suppress AndroidDomInspection -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>

        <!-- Pushes: Capacitor's service, plus the notifications with buttons
             (Approve / Decline, Reply), which arrive as data and are drawn
             and answered by the app itself. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".OlanoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- How FCM draws a push while the app is in the background: a white
             glyph in the status bar, tinted with the brand colour. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_olano" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/olano_accent" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notifications (Android 13+ asks the person first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Taking a photo to attach to a message (asked for on first use).
         Choosing photos needs no permission: the system picker hands over
         only what the person picked. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Recording a voice note (asked for on first use). The web view
         records; Capacitor asks for both when the page wants the microphone,
         and Chromium adjusts the audio mode while recording (no prompt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Reading replies aloud with the phone's own voice: since Android 11 an
         app sees the text-to-speech engine only if it says it looks for one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Live dictation: the phone's speech recognition service must be visible to the app. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions a library could merge in that the app must not hold. No
         advertising ID: the app has no ads or analytics, and declaring it
         would change Play Console's "advertising ID" answer. No media or
         storage reads: photos come from the system photo picker, which needs
         none, and Play restricts READ_MEDIA_* to apps whose core use needs
         broad media access. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- The app works without a camera or a microphone, so neither hides it in Play. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
