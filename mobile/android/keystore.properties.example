# Release signing for Google Play: copy to keystore.properties (git-ignored,
# mobile/.gitignore) and fill in. Never commit the real file or the keystore.
# On CI, set OLANO_UPLOAD_STORE_FILE, OLANO_UPLOAD_STORE_PASSWORD,
# OLANO_UPLOAD_KEY_ALIAS and OLANO_UPLOAD_KEY_PASSWORD instead.
# storeFile is resolved relative to android/app/ (or give an absolute path).
storeFile=/absolute/path/to/olano-upload.jks
storePassword=
keyAlias=upload
keyPassword=
