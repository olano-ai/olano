# Olano self-hosted: .env for deploy/self-host/docker-compose.yml.
# setup.sh copies this file to .env and fills in the generated values; edit the
# rest by hand. Every Olano setting can also be written as OLANO_<NAME> or the
# older LIONCLAW_<NAME>; both spellings work.

# ── Generated by setup.sh (do not change once the stack has started) ─────────
# COMPOSE_PROJECT_NAME=olano          # prefixes the volumes; renaming it orphans your data
# LIONCLAW_PG_PASSWORD=<random>       # the bundled Postgres password; read only when the volume is created
# OLANO_PG_NAME=olano                 # the Postgres role, database and volume stem
# OLANO_MEM_LIMIT=<75% of RAM>m       # the runtime container's memory cap; 0 = none
# OLANO_SETUP_CODE=ABCD-EFGH-JKMN     # one-time code the dashboard asks for before it
#                                     # creates the first admin account; spent once it exists
# COMPOSE_FILE=docker-compose.yml     # which compose files load; setup.sh rewrites it on
#                                     # every run (adds docker-compose.https.yml for a public
#                                     # hostname, docker-compose.sandbox.yml for --sandbox)

# ── Where the dashboard is reached ───────────────────────────────────────────
# setup.sh chooses on the first run: https on <your-ip-with-dashes>.sslip.io when
# this machine's public IPv4 is on one of its own interfaces (a VPS), otherwise
# http://localhost:3200. Change it with
#   bash setup.sh --host olano.example.com   # your domain, https (DNS must point here)
#   bash setup.sh --host auto                # https on <your-ip>.sslip.io
#   bash setup.sh --local                    # http://localhost:3200 only
# which set these (Caddy obtains the Let's Encrypt certificate itself).
# OLANO_SITE_ADDRESS=:80              # ":80" = no public site; a hostname = https on 80/443
# LIONCLAW_PUBLIC_URL=http://localhost:3200
#
# The plain-http port is published on the host's loopback only, in every mode:
# http://localhost:3200 on the machine itself, or through an SSH tunnel.
# OLANO_HTTP_PORT=3200
# OLANO_HTTP_BIND=127.0.0.1           # 0.0.0.0 opens it to your LAN: unencrypted, so only on
#                                     # a network you trust and never on a public server

# ── Agents' shell commands ───────────────────────────────────────────────────
# By default they run inside the runtime container. bash setup.sh --sandbox
# gives every agent its own sandbox container instead (it mounts the host's
# Docker socket into the runtime, which is root-equivalent on the host: only
# on a machine you alone control) and sets these; --no-sandbox turns it off.
# OLANO_SANDBOX_EXEC=1
# OLANO_SANDBOX_IMAGE=ghcr.io/olano-ai/olano-sandbox:latest   # what setup.sh pulls and tags
#                                                             # as olano-sandbox:latest

# ── Where the data lives ─────────────────────────────────────────────────────
# A directory next to the compose file by default. Set an absolute path to keep
# it elsewhere; back that directory up and you have backed up the install.
# OLANO_DATA_DIR=/srv/olano

# ── Models ───────────────────────────────────────────────────────────────────
# Either or both. Keys can also be pasted in the dashboard (the setup wizard,
# or Vault / Providers), which stores them encrypted; .env is for an
# unattended install.
#
# An Olano API key (cloud.olano.ai → API keys, starts with sk-olano-) runs the
# Olano tiers, image generation, vision, speech and web search on your
# account's credits, with no provider accounts.
# OLANO_CREDITS_KEY=sk-olano-...
#
# Your own provider keys (any number of them).
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# GOOGLE_API_KEY=...

# ── Images ───────────────────────────────────────────────────────────────────
# :latest is the current release. Pin a version to update on your own schedule.
# OLANO_BACKEND_IMAGE=ghcr.io/olano-ai/olano-backend:latest
# OLANO_DASHBOARD_IMAGE=ghcr.io/olano-ai/olano-dashboard:latest

# ── Vault ────────────────────────────────────────────────────────────────────
# Leave unset: the first boot generates a vault passphrase and keeps it in the
# data directory. Set it only to choose the passphrase yourself, before the
# first start.
# OLANO_VAULT_KEY=
