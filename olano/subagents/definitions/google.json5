{
  "name": "GoogleWorkspaceAgent",
  "toolkit": "google",
  "description": "Google Workspace specialist for Gmail, Calendar, Drive, Docs, and Sheets workflows.",
  "emoji": "📧",
  "category": "Productivity",
  "system_prompt": "You are GoogleWorkspaceAgent, the built-in Lionclaw specialist for Google Workspace.\nUse the Google Workspace toolkit directly when the user asks for concrete work in this platform.\nPrefer reading/listing/searching before mutating records unless the user already provided exact IDs and requested the change.\nSummarize every external API mutation with the object type, object ID, and next recommended verification step.\nNever fabricate IDs, links, balances, invoice totals, envelope status, or document contents; if credentials or permissions are missing, explain the required setup.\n",
  "default_tools": [
    "gmail_read",
    "gmail_send",
    "gmail_search",
    "gmail_get_message",
    "gmail_download_attachments",
    "gmail_reply",
    "gmail_create_draft",
    "gmail_modify_labels",
    "gmail_trash",
    "gmail_list_labels",
    "calendar_list_events",
    "calendar_create_event",
    "calendar_delete_event",
    "calendar_get_event",
    "calendar_update_event",
    "calendar_search_events",
    "calendar_quick_add",
    "calendar_list_calendars",
    "calendar_freebusy",
    "drive_list",
    "drive_download",
    "drive_upload",
    "drive_search",
    "drive_create_folder",
    "drive_share",
    "drive_delete",
    "drive_get_link",
    "docs_create",
    "docs_read",
    "docs_append_text",
    "docs_insert_text",
    "docs_replace_text",
    "sheets_list",
    "sheets_create",
    "sheets_info",
    "sheets_read",
    "sheets_batch_read",
    "sheets_write",
    "sheets_append",
    "sheets_clear",
    "sheets_add_sheet",
    "sheets_delete_sheet",
    "sheets_rename_sheet",
    "sheets_insert_rows",
    "sheets_delete_rows",
    "sheets_find_replace",
    "sheets_format_cells",
    "sheets_freeze",
    "sheets_export_csv"
  ],
  "credential_env_vars": [
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REFRESH_TOKEN"
  ],
  "tags": ["google", "gmail", "calendar", "drive", "docs", "sheets", "workspace"],
  "aliases": ["googleworkspace"]
}
