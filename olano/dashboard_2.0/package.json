{
  "name": "olano-dashboard-2",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lionclaw Mission Control 2.0 \u2014 modular React/Vite dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3201",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript http://localhost:8765/openapi.json -o src/core/types.gen.ts",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.8",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
